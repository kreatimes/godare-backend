# Variables de entorno necesarias para ejecutar el backend de GoDare.
# Copia este archivo como .env y rellena los valores antes de arrancar.

MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
MONGO_DATABASE=godare

JWT_SECRET=tu_secret_en_base64_de_al_menos_256_bits
JWT_EXPIRATION_MS=15552000000

CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_UPLOAD_PRESET=tu_upload_preset

BREVO_API_KEY=tu_brevo_api_key

APP_URL=https://TU_RAILWAY_URL.up.railway.app
